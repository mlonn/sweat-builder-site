{
  "$schema": "https://unpkg.com/wrangler@4.164.0/config-schema.json",
  "name": "sweat-builder-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  // Static site: everything in this folder except what .assetsignore lists.
  // The Worker runs first so it can send the old domain on to the new one.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "sweatbuilder.losell.nu", "custom_domain": true },
    // The old domain. A route (not a custom domain), so its existing DNS record can stay.
    { "pattern": "sweatbuilder.lonn.xyz/*", "zone_name": "lonn.xyz" }
  ]
}
